<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>

        <!-- NuGet package metadata — all values below are placeholders.
             TODO(template): update PackageId, Authors, Description, and RepositoryUrl for your project. -->
        <PackageId>ExampleLibrary</PackageId>
        <Authors>Your Name</Authors>
        <Description>Example library demonstrating this template's CI/CD and release pipeline.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/your-username/your-repo</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="ExampleLibrary.Tests" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="AWSSDK.S3" Version="4.0.101.3" />
    </ItemGroup>
</Project>